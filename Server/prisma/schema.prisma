generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  userName            String               @unique
  /** E.164 digits only, e.g. 254712345678 — used for phone login */
  phoneE164           String?              @unique
  phoneNo             Int?
  address             String?
  fid                 Int?
  smartAddress        String               @unique
  profileImageUrl     String?
  hashedPassphrase    String
  hashedPrivkey       String
  cdpWalletId         String?
  location            String?
  emailNotify         Boolean              @default(true)
  expoPushToken       String?
  pushNotify          Boolean              @default(false)
  /** 1 = default (20k KES/mo), 2 = Didit-verified (100k KES/mo) */
  kycTier             Int                  @default(1)
  /** none | pending | pending_review | approved | rejected */
  kycStatus           String               @default("none")
  kycVerifiedAt       DateTime?
  /** Didit OCR — Identity Card | Passport | Driver's License | … */
  kycDocumentType     String?
  kycFirstName        String?
  kycLastName         String?
  kycFullName         String?
  /** YYYY-MM-DD from Didit OCR */
  kycDateOfBirth      String?
  /** Document / national ID number — AES-encrypted at rest (see Lib/kycPii.ts) */
  kycDocumentNumber   String?
  /** ISO 3166-1 alpha-3 when provided */
  kycNationality      String?
  createdChamas       Chama[]              @relation("AdminChamas")
  chamas              ChamaMember[]
  joinRequests        ChamaRequest[]
  messages            Message[]
  notifications       Notification[]
  payOuts             PayOut[]
  payments            Payment[]
  pretiumTransactions PretiumTransaction[]
  moonwellYields      MoonwellYield[]
  kycJobs             KycJob[]
  createdGoals        Goal[]               @relation("GoalCreator")
  goalMemberships     GoalMember[]
  goalContributions   GoalContribution[]   @relation("GoalContributor")
  goalContributionPays GoalContribution[]  @relation("GoalPayer")
  goalWithdrawals     GoalWithdrawal[]
}

model KycJob {
  id           Int      @id @default(autoincrement())
  userId       Int
  provider     String   @default("didit")
  /** Didit session_id (or local sandbox job id) */
  jobId        String   @unique
  documentType String
  /** pending | processing | approved | rejected | error */
  status       String   @default("pending")
  rawResultRef String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

model MoonwellYield {
  id        Int      @id @default(autoincrement())
  userId    Int
  earned    String
  balance   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
}

model Chama {
  id            Int            @id @default(autoincrement())
  name          String
  slug          String         @unique
  description   String?
  adminTerms    String?
  type          String
  payDate       DateTime
  cycleTime     Int
  status        String         @default("active")
  amount        String
  round         Int            @default(1)
  cycle         Int            @default(1)
  maxNo         Int            @default(15)
  rating        Int            @default(0)
  raterCount    Int            @default(0)
  blockchainId  String
  adminId       Int
  canJoin       Boolean        @default(true)
  payOutOrder   String?
  txHash        String?
  createdAt     DateTime       @default(now())
  admin         User           @relation("AdminChamas", fields: [adminId], references: [id])
  members       ChamaMember[]
  requests      ChamaRequest[]
  messages      Message[]
  notifications Notification[]
  payOuts       PayOut[]
  payments      Payment[]
  roundOutcome  roundOutcome[]
  refunds       Refund[]

  @@index([payDate])
  @@index([status, payDate])
}

model ChamaMember {
  id           Int      @id @default(autoincrement())
  userId       Int
  chamaId      Int
  payDate      DateTime
  lastReadTime DateTime @default(now())
  txHash       String?
  chama        Chama    @relation(fields: [chamaId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@index([chamaId, userId])
}

model Payment {
  id          Int      @id @default(autoincrement())
  amount      String
  description String?
  doneAt      DateTime @default(now())
  txHash      String
  userId      Int
  chamaId     Int?
  sender      String?
  receiver    String?
  chama       Chama?   @relation(fields: [chamaId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, doneAt(sort: Desc)])
}

model Notification {
  id         Int      @id @default(autoincrement())
  message    String
  senderId   Int?
  requestId  Int?
  userId     Int
  chamaId    Int?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  type       String?
  sharedLink String?
  chama      Chama?   @relation(fields: [chamaId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([chamaId, type])
}

model ChamaRequest {
  id        Int      @id @default(autoincrement())
  status    String   @default("pending")
  createdAt DateTime @default(now())
  userId    Int
  chamaId   Int
  chama     Chama    @relation(fields: [chamaId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Message {
  id        Int      @id @default(autoincrement())
  chamaId   Int
  senderId  Int
  text      String
  timestamp DateTime @default(now())
  chama     Chama    @relation(fields: [chamaId], references: [id])
  sender    User     @relation(fields: [senderId], references: [id])
}

model PayOut {
  id       Int      @id @default(autoincrement())
  amount   String
  doneAt   DateTime @default(now())
  txHash   String?
  receiver String
  userId   Int
  chamaId  Int
  chama    Chama    @relation(fields: [chamaId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([userId, doneAt(sort: Desc)])
}

model roundOutcome {
  id           Int      @id @default(autoincrement())
  disburse     Boolean
  chamaCycle   Int
  chamaRound   Int
  amountPaid   String
  shownMembers String?
  createdAt    DateTime @default(now())
  chamaId      Int
  chama        Chama    @relation(fields: [chamaId], references: [id])
}

model PretiumTransaction {
  id               Int      @id @default(autoincrement())
  userId           Int
  transactionCode  String   @unique
  isOnramp         Boolean
  pretiumType      String?
  shortcode        String?
  account_number   String?
  amount           Decimal  @db.Decimal(10, 2)
  type             String   @default("payment")
  status           String   @default("pending")
  receiptNumber    String?
  transactionDate  String?
  isRealesed       Boolean
  message          String?
  chamaId          Int?
  goalId           Int?
  memberForId      Int?
  cusdAmount       Decimal? @db.Decimal(18, 6)
  exchangeRate     Decimal? @db.Decimal(10, 2)
  walletAddress    String?
  blockchainTxHash String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
  goal             Goal?    @relation(fields: [goalId], references: [id])

  @@index([userId])
  @@index([transactionCode])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([goalId])
}

model Refund {
  id        Int      @id @default(autoincrement())
  cycle     Int
  round     Int
  createdAt DateTime @default(now())
  chamaId   Int
  chama     Chama    @relation(fields: [chamaId], references: [id])
}

/// Save-for-Goal pot (mirrors on-chain ChamaPayGoal + off-chain metadata)
model Goal {
  id              Int                 @id @default(autoincrement())
  name            String
  slug            String              @unique
  description     String?
  /// personal | invite | public
  goalType        String
  /// Target in USDC (6-decimal string), "0" = open-ended
  targetAmount    String              @default("0")
  endDate         DateTime?
  yieldEnabled    Boolean             @default(false)
  /// On-chain goalId from ChamaPayGoal
  blockchainId    String
  createTxHash    String?
  /// active | closed
  status          String              @default("active")
  /// WhatsApp E.164 for contribution updates (optional)
  notifyPhone     String?
  coverImageUrl   String?
  creatorId       Int
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  creator         User                @relation("GoalCreator", fields: [creatorId], references: [id])
  members         GoalMember[]
  contributions   GoalContribution[]
  withdrawals     GoalWithdrawal[]
  pretiumTransactions PretiumTransaction[]

  @@index([creatorId, createdAt(sort: Desc)])
  @@index([status])
  @@index([goalType])
  @@index([blockchainId])
}

model GoalMember {
  id        Int      @id @default(autoincrement())
  goalId    Int
  userId    Int
  joinedAt  DateTime @default(now())
  txHash    String?
  goal      Goal     @relation(fields: [goalId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([goalId, userId])
  @@index([userId])
}

model GoalContribution {
  id                  Int      @id @default(autoincrement())
  goalId              Int
  amount              String
  /// On-chain credited address (member or treasury for guests)
  contributorAddress  String
  /// On-chain payer (msg.sender)
  payerAddress        String
  contributorUserId   Int?
  payerUserId         Int?
  /// True when pay-link guest / treasury-funded stranger deposit
  isGuest             Boolean  @default(false)
  /// Display name from Pretium / form for guests
  guestDisplayName    String?
  txHash              String
  pretiumTxCode       String?
  createdAt           DateTime @default(now())
  goal                Goal     @relation(fields: [goalId], references: [id])
  contributorUser     User?    @relation("GoalContributor", fields: [contributorUserId], references: [id])
  payerUser           User?    @relation("GoalPayer", fields: [payerUserId], references: [id])

  @@index([goalId, createdAt(sort: Desc)])
  @@index([contributorUserId])
  @@index([txHash])
}

model GoalWithdrawal {
  id        Int      @id @default(autoincrement())
  goalId    Int
  amount    String
  /// all | yield | principal | amount
  mode      String
  txHash    String
  creatorId Int
  createdAt DateTime @default(now())
  goal      Goal     @relation(fields: [goalId], references: [id])
  creator   User     @relation(fields: [creatorId], references: [id])

  @@index([goalId, createdAt(sort: Desc)])
  @@index([creatorId])
}
