# Email Configuration for OTP verification
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@chamapay.com
APP_URL=http://localhost:8082

# Existing JWT Secret
JWT_SECRET=your-jwt-secret-here

# Alchemy Webhook Configuration
ALCHEMY_WEBHOOK_SIGNING_KEY=your-alchemy-webhook-signing-key
ALCHEMY_API_KEY=your-alchemy-api-key
# Optional override (defaults to Alchemy Base mainnet when ALCHEMY_API_KEY is set)
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your-alchemy-api-key
USDC_CONTRACT_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Coinbase Developer Platform — EIP-7702 + Paymaster (Base mainnet)
# Portal -> Onchain Tools -> Paymaster -> Configuration
COINBASE_PAYMASTER_URL=https://api.developer.coinbase.com/rpc/v1/base/your-api-key

# CDP API credentials (Portal -> API Keys)
CDP_API_KEY_ID=your-api-key-id
CDP_API_KEY_SECRET=your-api-key-secret
CDP_WALLET_SECRET=your-wallet-secret
# Legacy alias supported by the server:
# WALLET_SECRET=your-wallet-secret

# Optional: App Store / Play Store install counts (falls back to user count if unset)
# STATS_IOS_DOWNLOADS=2847
# STATS_ANDROID_DOWNLOADS=4123

# --- Tier-2 KYC (Didit) ---
# Console: https://business.didit.me — use a SANDBOX application while integrating
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# true = Didit Console sandbox app (passes sandbox_scenario on session create)
DIDIT_SANDBOX=true
# Optional scenario slug (default: approve). Examples: decline_document_expired, review_face_match_borderline
# DIDIT_SANDBOX_SCENARIO=approve
# Offline only — skip Didit API entirely (not the same as Console sandbox)
# DIDIT_LOCAL_MOCK=true
# Webhook destination URL: https://your-api-host/kyc/webhook  (status.updated)
# --- WhatsApp OTP (phone login) ---
# Meta Cloud API — already used for WhatsApp OTP
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional approved authentication template name (recommended for production)
# WHATSAPP_OTP_TEMPLATE=chamapay_otp
# WHATSAPP_OTP_TEMPLATE_LANG=en
# Set true only in local/dev to return OTP in API response
# WHATSAPP_OTP_DEBUG=false

